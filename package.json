{
  "name": "ctl-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.30.3 <11"
  },
  "scripts": {
    "predev": "pnpm agents:check",
    "dev": "pnpm --filter ctmux-app exec vite",
    "build": "pnpm --filter ctmux-app exec tsc && pnpm --filter ctmux-app exec vite build",
    "check": "pnpm check:scripts && pnpm --filter ctmux-app exec tsc --noEmit",
    "check:scripts": "tsc -p tsconfig.scripts.json",
    "test": "pnpm test:scripts && pnpm test:frontend",
    "test:frontend": "pnpm --filter ctmux-app exec vitest run",
    "test:scripts": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test scripts/dev/*.test.mts scripts/ci/*.test.mts",
    "test:dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test scripts/dev/*.test.mts",
    "test:ci": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test scripts/ci/*.test.mts",
    "desktop:dev": "pnpm --filter ctmux-app dev",
    "desktop:dev:signed": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/dev/tauri-signed.mts",
    "desktop:build": "pnpm --filter ctmux-app exec tauri build",
    "desktop:preview": "pnpm --filter ctmux-app exec vite --host 127.0.0.1",
    "provision": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/dev/ctld-signed.mts --provision",
    "ctld:signed": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/dev/ctld-signed.mts",
    "daemons:build": "cargo build --locked -p ctld -p ctmuxd -p ctl-taskd",
    "agents:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/dev/sync-agent-bundles.mts --check",
    "agents:sync": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/dev/sync-agent-bundles.mts"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "~5.8.3"
  }
}
