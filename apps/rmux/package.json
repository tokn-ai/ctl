{
  "name": "rmux-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node --experimental-strip-types --disable-warning=ExperimentalWarning ../../scripts/dev/sync-agent-bundles.mts --check",
    "dev": "vite",
    "daemons:build": "cargo build --locked --manifest-path ../../Cargo.toml -p ctld -p rmuxd -p taskd",
    "build": "tsc && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "agents:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning ../../scripts/dev/sync-agent-bundles.mts --check",
    "agents:sync": "node --experimental-strip-types --disable-warning=ExperimentalWarning ../../scripts/dev/sync-agent-bundles.mts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev:provision": "node --experimental-strip-types --disable-warning=ExperimentalWarning ../../scripts/dev/tauri-signed.mts --provision",
    "tauri:dev:signed": "node --experimental-strip-types --disable-warning=ExperimentalWarning ../../scripts/dev/tauri-signed.mts",
    "test": "vitest run",
    "test:dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test ../../scripts/dev/*.test.mts",
    "test:ci": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test ../../scripts/ci/*.test.mts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@xterm/headless": "6.0.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "4.1.11"
  }
}
