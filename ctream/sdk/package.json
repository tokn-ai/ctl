{
  "name": "@tokn-ai/ctream-sdk",
  "version": "0.1.4",
  "description": "Observe and control ctream displays and windows from Node.js or Bun",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tokn-ai/ctl.git",
    "directory": "ctream/sdk"
  },
  "exports": {
    ".": {
